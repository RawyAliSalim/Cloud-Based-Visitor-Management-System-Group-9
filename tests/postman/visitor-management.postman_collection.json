{
  "info": {
    "name": "Visitor Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Notifications",
      "description": "Host Notification Service. Log in first with the matching role so Postman stores the session cookie.",
      "item": [
        {
          "name": "Host - list own notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('No contact details in response', function () {",
                  "  pm.expect(pm.response.text()).to.not.include('\"email\"');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notifications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "notifications"
              ]
            },
            "description": "Log in as the host first."
          },
          "response": []
        },
        {
          "name": "Host - list another host notifications (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403', function () {",
                  "  pm.response.to.have.status(403);",
                  "});",
                  "pm.test('Error code is FORBIDDEN', function () {",
                  "  pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notifications?hostId={{otherHostId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "notifications"
              ],
              "query": [
                {
                  "key": "hostId",
                  "value": "{{otherHostId}}"
                }
              ]
            },
            "description": "Log in as a host. otherHostId is a different host."
          },
          "response": []
        },
        {
          "name": "Host - save FCM token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notifications/fcm-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "notifications",
                "fcm-token"
              ]
            },
            "description": "Log in as the host first.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{fcmToken}}\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Host - save FCM token wrong content type (415)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 415', function () {",
                  "  pm.response.to.have.status(415);",
                  "});",
                  "pm.test('Error code is UNSUPPORTED_MEDIA_TYPE', function () {",
                  "  pm.expect(pm.response.json().error.code).to.eql('UNSUPPORTED_MEDIA_TYPE');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/notifications/fcm-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "notifications",
                "fcm-token"
              ]
            },
            "description": "Body sent as text/plain.",
            "body": {
              "mode": "raw",
              "raw": "token"
            }
          },
          "response": []
        },
