{
  "name": "visitor-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Cloud-Based Visitor Management System (Group 9)",
  "main": "server/app.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node --watch server/server.js",
    "start": "node server/server.js",
    "seed": "node server/scripts/seed.js",
    "test": "node --test \"tests/integration/*.test.js\"",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "firebase-admin": "^12.7.0",
    "mongoose": "^8.8.0",
    "serverless-http": "^4.0.0"
  }
}
